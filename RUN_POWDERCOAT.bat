:: หา IP Address ของเครื่องนี้ในวง Wi-Fi / LAN
set LOCAL_IP=localhost
for /f "tokens=4" %%a in ('route print ^| findstr 0.0.0.0 ^| findstr /v "0.0.0.0.*0.0.0.0"') do (
    set LOCAL_IP=%%a
    goto :ip_found
)
:ip_found

